# Timeweb AI Agents (как в задании: у каждой роли свой OpenAI URL + token).
# URL копируйте в карточке агента → Интеграции → «Скопировать OpenAI URL».
# Токен: карточка агента → Управление → Доступ по API (не «API и Terraform»).
# Пример URL: https://agent.timeweb.cloud/api/v1/cloud-ai/agents/ACCESS_ID/v1

PRODUCT_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/PUT_PRODUCT_ID/v1
PRODUCT_TOKEN=YOUR_PRODUCT_TOKEN
PRODUCT_MODEL=deepseek/deepseek-v4-flash

PROJECT_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/PUT_PROJECT_ID/v1
PROJECT_TOKEN=YOUR_PROJECT_TOKEN
PROJECT_MODEL=deepseek/deepseek-v4-flash

BACKEND_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/PUT_BACKEND_ID/v1
BACKEND_TOKEN=YOUR_BACKEND_TOKEN
BACKEND_MODEL=deepseek/deepseek-v4-flash

FRONTEND_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/PUT_FRONTEND_ID/v1
FRONTEND_TOKEN=YOUR_FRONTEND_TOKEN
FRONTEND_MODEL=deepseek/deepseek-v4-flash

# Необязательно: отдельный агент-председатель для JSON-синтеза.
# Если пусто — синтез идёт через PRODUCT.
# CHAIR_BASE_URL=
# CHAIR_TOKEN=
# CHAIR_MODEL=

# Запасной вариант (один Gateway на всех) — только для локальной отладки.
# LLM_BASE_URL=https://api.timeweb.ai/v1
# LLM_TOKEN=
# LLM_MODEL=deepseek/deepseek-v4-flash

MAX_IDEA_LENGTH=6000
PORT=8000
